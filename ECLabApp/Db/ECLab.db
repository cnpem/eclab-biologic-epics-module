record(stringout, "${P}${R}IP") {
    field(DTYP, "asynOctetWrite")
    field(OUT,  "@asyn(${PORT})IP")
}

record(stringin, "${P}${R}IP_RBV") {
    field(DTYP, "asynOctetRead")
    field(INP,   "@asyn(${PORT})IP")
    field(SCAN,  "I/O Intr")
}

record(longout, "${P}${R}CHANNEL_MASK") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn(${PORT})CHANNEL_MASK")
}

record(longin, "${P}${R}CHANNEL_MASK_RBV") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn(${PORT})CHANNEL_MASK")
    field(SCAN, "I/O Intr")
}

record(bo, "${P}${R}CONNECT") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn(${PORT})CONNECT")
    field(ZNAM, "Disconnect")
    field(ONAM, "Connect")
}

record(bi, "${P}${R}CONNECTED_RBV") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn(${PORT})CONNECT")
    field(ZNAM, "Disconnected")
    field(ONAM, "Connected")
    field(SCAN, "I/O Intr")
}

record(stringin, "${P}${R}LIB_VERSION_RBV") {
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn(${PORT})LIB_VERSION")
    field(SCAN, "I/O Intr")
}

record(longin, "${P}${R}DEVICE_CODE_RBV") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn(${PORT})DEVICE_CODE")
    field(SCAN, "I/O Intr")
}

record(longin, "${P}${R}NUMBER_OF_SLOTS_RBV") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn(${PORT})NUMBER_OF_SLOTS")
    field(SCAN, "I/O Intr")
}

record(waveform, "${P}${R}CHANNEL_PLUGGED_RBV") {
    field(DTYP, "asynInt32ArrayIn")
    field(INP, "@asyn(${PORT})CHANNEL_PLUGGED")
    field(FTVL, "LONG")
    field(NELM, "16")
    field(SCAN, "I/O Intr")
}

record(waveform, "${P}${R}FIRMWARE_STATUS_RBV") {
    field(DTYP, "asynInt32ArrayIn")
    field(INP, "@asyn(${PORT})FIRMWARE_STATUS")
    field(FTVL, "LONG")
    field(NELM, "16")
    field(SCAN, "I/O Intr")
}
