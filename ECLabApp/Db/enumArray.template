record(waveform, "${P}${R}${TEC}${PARAM}") {
    field(DTYP, "asynInt32ArrayOut")
    field(INP, "@asyn(${PORT})${PARAM}:E")
    field(FTVL, "LONG")
    field(NELM, "100")
}

record(waveform, "${P}${R}${TEC}${PARAM}_RBV") {
    field(DTYP, "asynInt32ArrayIn")
    field(INP, "@asyn(${PORT})${PARAM}:E")
    field(FTVL, "LONG")
    field(NELM, "100")
    field(SCAN, "I/O Intr")
}
